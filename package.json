{
  "name": "serper-dev-mcp",
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "description": "Model Context Protocol server for Serper.dev search and scraping APIs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "serper-dev-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "serper",
    "google-search",
    "search",
    "scraping"
  ],
  "author": "GreXLin85",
  "homepage": "https://github.com/GreXLin85/serper.dev-mcp#readme",
  "bugs": {
    "url": "https://github.com/GreXLin85/serper.dev-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GreXLin85/serper.dev-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
